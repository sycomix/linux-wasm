From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Linux-Wasm Builder <builder@linux-wasm.local>
Date: Wed, 13 Nov 2025 00:00:00 +0000
Subject: [PATCH] Add Wasm input support

Adds keyboard and mouse input drivers that receive events from
JavaScript and inject them into the Linux input subsystem.
---
 arch/wasm/drivers/Kconfig          |  24 ++++
 arch/wasm/drivers/Makefile         |   2 +
 arch/wasm/drivers/input_kbd_wasm.c | 141 ++++++++++++++++++++++
 arch/wasm/drivers/input_mouse_wasm.c | 171 +++++++++++++++++++++++++++
 4 files changed, 338 insertions(+)
 create mode 100644 arch/wasm/drivers/input_kbd_wasm.c
 create mode 100644 arch/wasm/drivers/input_mouse_wasm.c

diff --git a/arch/wasm/drivers/Kconfig b/arch/wasm/drivers/Kconfig
index 5c8b96ab3..f8b0a2e5c 100644
--- a/arch/wasm/drivers/Kconfig
+++ b/arch/wasm/drivers/Kconfig
@@ -32,4 +32,28 @@ config FB_WASM
 
 	  If you don't know what to do here, say Y.
 
+config INPUT_WASM_KEYBOARD
+	bool "Wasm keyboard driver"
+	depends on INPUT && INPUT_KEYBOARD
+	help
+	  This enables a keyboard input driver that receives key events
+	  from JavaScript in the browser. The driver injects these events
+	  into the Linux input subsystem, making them available to
+	  applications through /dev/input/event* devices.
+
+	  The driver supports standard PC keyboard scancodes.
+
+	  If you don't know what to do here, say Y.
+
+config INPUT_WASM_MOUSE
+	bool "Wasm mouse driver"
+	depends on INPUT && INPUT_MOUSE
+	help
+	  This enables a mouse input driver that receives mouse events
+	  from JavaScript in the browser. The driver injects position,
+	  button, and wheel events into the Linux input subsystem.
+
+	  The driver supports absolute positioning within the framebuffer.
+
+	  If you don't know what to do here, say Y.
+
 endmenu
diff --git a/arch/wasm/drivers/Makefile b/arch/wasm/drivers/Makefile
index d5fb61e9f..a6e8e8e69 100644
--- a/arch/wasm/drivers/Makefile
+++ b/arch/wasm/drivers/Makefile
@@ -2,3 +2,5 @@
 
 obj-$(CONFIG_HVC_WASM) += hvc_wasm.o
 obj-$(CONFIG_FB_WASM) += fb_wasm.o
+obj-$(CONFIG_INPUT_WASM_KEYBOARD) += input_kbd_wasm.o
+obj-$(CONFIG_INPUT_WASM_MOUSE) += input_mouse_wasm.o
diff --git a/arch/wasm/drivers/input_kbd_wasm.c b/arch/wasm/drivers/input_kbd_wasm.c
new file mode 100644
index 000000000..9e8f7a8a9
--- /dev/null
+++ b/arch/wasm/drivers/input_kbd_wasm.c
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Wasm keyboard input driver
+ *
+ * Receives keyboard events from JavaScript host and injects them
+ * into the Linux input subsystem.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/input.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#define DRIVER_NAME "input_kbd_wasm"
+
+struct kbd_wasm_dev {
+	struct input_dev *input;
+	struct platform_device *pdev;
+};
+
+static struct kbd_wasm_dev *kbd_dev_global;
+
+/**
+ * wasm_input_keyboard_event - Inject keyboard event from JavaScript
+ * @scancode: Linux scancode (from input-event-codes.h)
+ * @pressed: 1 if key pressed, 0 if released
+ *
+ * Called directly from JavaScript when keyboard events occur in the browser.
+ * This function injects the event into the Linux input subsystem.
+ */
+void wasm_input_keyboard_event(int scancode, int pressed)
+{
+	if (!kbd_dev_global || !kbd_dev_global->input) {
+		pr_warn_once("kbd_wasm: Event received but device not ready\n");
+		return;
+	}
+
+	/* Report key event */
+	input_report_key(kbd_dev_global->input, scancode, pressed);
+	input_sync(kbd_dev_global->input);
+}
+EXPORT_SYMBOL(wasm_input_keyboard_event);
+
+static int kbd_wasm_probe(struct platform_device *pdev)
+{
+	struct kbd_wasm_dev *kbd_dev;
+	struct input_dev *input;
+	int ret;
+	int i;
+
+	kbd_dev = kzalloc(sizeof(*kbd_dev), GFP_KERNEL);
+	if (!kbd_dev)
+		return -ENOMEM;
+
+	input = input_allocate_device();
+	if (!input) {
+		ret = -ENOMEM;
+		goto err_free_dev;
+	}
+
+	kbd_dev->input = input;
+	kbd_dev->pdev = pdev;
+	kbd_dev_global = kbd_dev;
+
+	input->name = "Wasm Keyboard";
+	input->phys = "wasm/input/keyboard";
+	input->id.bustype = BUS_HOST;
+	input->id.vendor = 0x0001;
+	input->id.product = 0x0001;
+	input->id.version = 0x0100;
+	input->dev.parent = &pdev->dev;
+
+	/* Enable key events */
+	set_bit(EV_KEY, input->evbit);
+	set_bit(EV_REP, input->evbit);
+
+	/* Enable all standard PC keyboard keys */
+	for (i = 0; i < KEY_MAX; i++)
+		set_bit(i, input->keybit);
+
+	ret = input_register_device(input);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register input device: %d\n", ret);
+		goto err_free_input;
+	}
+
+	platform_set_drvdata(pdev, kbd_dev);
+
+	dev_info(&pdev->dev, "Wasm keyboard driver initialized\n");
+	return 0;
+
+err_free_input:
+	input_free_device(input);
+err_free_dev:
+	kfree(kbd_dev);
+	return ret;
+}
+
+static int kbd_wasm_remove(struct platform_device *pdev)
+{
+	struct kbd_wasm_dev *kbd_dev = platform_get_drvdata(pdev);
+
+	if (kbd_dev_global == kbd_dev)
+		kbd_dev_global = NULL;
+
+	input_unregister_device(kbd_dev->input);
+	kfree(kbd_dev);
+
+	return 0;
+}
+
+static struct platform_driver kbd_wasm_driver = {
+	.probe	= kbd_wasm_probe,
+	.remove	= kbd_wasm_remove,
+	.driver	= {
+		.name	= DRIVER_NAME,
+	},
+};
+
+static struct platform_device *kbd_wasm_pdev;
+
+static int __init kbd_wasm_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&kbd_wasm_driver);
+	if (ret)
+		return ret;
+
+	kbd_wasm_pdev = platform_device_register_simple(DRIVER_NAME, -1, NULL, 0);
+	if (IS_ERR(kbd_wasm_pdev)) {
+		platform_driver_unregister(&kbd_wasm_driver);
+		return PTR_ERR(kbd_wasm_pdev);
+	}
+
+	return 0;
+}
+
+module_init(kbd_wasm_init);
+
+MODULE_DESCRIPTION("Wasm keyboard input driver");
+MODULE_LICENSE("GPL");
diff --git a/arch/wasm/drivers/input_mouse_wasm.c b/arch/wasm/drivers/input_mouse_wasm.c
new file mode 100644
index 000000000..3ab8a4a8e
--- /dev/null
+++ b/arch/wasm/drivers/input_mouse_wasm.c
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Wasm mouse input driver
+ *
+ * Receives mouse events from JavaScript host and injects them
+ * into the Linux input subsystem.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/input.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#define DRIVER_NAME "input_mouse_wasm"
+
+/* Default framebuffer dimensions - should match fb_wasm.c */
+#define MOUSE_MAX_X 800
+#define MOUSE_MAX_Y 600
+
+struct mouse_wasm_dev {
+	struct input_dev *input;
+	struct platform_device *pdev;
+	int last_x;
+	int last_y;
+};
+
+static struct mouse_wasm_dev *mouse_dev_global;
+
+/**
+ * wasm_input_mouse_event - Inject mouse event from JavaScript
+ * @x: Absolute X coordinate (0 to framebuffer width)
+ * @y: Absolute Y coordinate (0 to framebuffer height)
+ * @buttons: Button state bitmask (bit 0=left, 1=right, 2=middle)
+ * @wheel: Mouse wheel delta (positive=up, negative=down, 0=none)
+ *
+ * Called directly from JavaScript when mouse events occur in the browser.
+ * This function injects the event into the Linux input subsystem.
+ */
+void wasm_input_mouse_event(int x, int y, int buttons, int wheel)
+{
+	if (!mouse_dev_global || !mouse_dev_global->input) {
+		pr_warn_once("mouse_wasm: Event received but device not ready\n");
+		return;
+	}
+
+	/* Report absolute position */
+	input_report_abs(mouse_dev_global->input, ABS_X, x);
+	input_report_abs(mouse_dev_global->input, ABS_Y, y);
+
+	/* Report button states */
+	input_report_key(mouse_dev_global->input, BTN_LEFT, buttons & 1);
+	input_report_key(mouse_dev_global->input, BTN_RIGHT, (buttons >> 1) & 1);
+	input_report_key(mouse_dev_global->input, BTN_MIDDLE, (buttons >> 2) & 1);
+
+	/* Report wheel movement if any */
+	if (wheel != 0)
+		input_report_rel(mouse_dev_global->input, REL_WHEEL, wheel);
+
+	/* Also report relative movement for applications that need it */
+	if (mouse_dev_global->last_x >= 0 && mouse_dev_global->last_y >= 0) {
+		int dx = x - mouse_dev_global->last_x;
+		int dy = y - mouse_dev_global->last_y;
+		if (dx != 0)
+			input_report_rel(mouse_dev_global->input, REL_X, dx);
+		if (dy != 0)
+			input_report_rel(mouse_dev_global->input, REL_Y, dy);
+	}
+
+	mouse_dev_global->last_x = x;
+	mouse_dev_global->last_y = y;
+
+	input_sync(mouse_dev_global->input);
+}
+EXPORT_SYMBOL(wasm_input_mouse_event);
+
+static int mouse_wasm_probe(struct platform_device *pdev)
+{
+	struct mouse_wasm_dev *mouse_dev;
+	struct input_dev *input;
+	int ret;
+
+	mouse_dev = kzalloc(sizeof(*mouse_dev), GFP_KERNEL);
+	if (!mouse_dev)
+		return -ENOMEM;
+
+	input = input_allocate_device();
+	if (!input) {
+		ret = -ENOMEM;
+		goto err_free_dev;
+	}
+
+	mouse_dev->input = input;
+	mouse_dev->pdev = pdev;
+	mouse_dev->last_x = -1;
+	mouse_dev->last_y = -1;
+	mouse_dev_global = mouse_dev;
+
+	input->name = "Wasm Mouse";
+	input->phys = "wasm/input/mouse";
+	input->id.bustype = BUS_HOST;
+	input->id.vendor = 0x0001;
+	input->id.product = 0x0002;
+	input->id.version = 0x0100;
+	input->dev.parent = &pdev->dev;
+
+	/* Enable button events */
+	set_bit(EV_KEY, input->evbit);
+	set_bit(BTN_LEFT, input->keybit);
+	set_bit(BTN_RIGHT, input->keybit);
+	set_bit(BTN_MIDDLE, input->keybit);
+
+	/* Enable absolute position */
+	set_bit(EV_ABS, input->evbit);
+	input_set_abs_params(input, ABS_X, 0, MOUSE_MAX_X, 0, 0);
+	input_set_abs_params(input, ABS_Y, 0, MOUSE_MAX_Y, 0, 0);
+
+	/* Enable relative movement (for compatibility) */
+	set_bit(EV_REL, input->evbit);
+	set_bit(REL_X, input->relbit);
+	set_bit(REL_Y, input->relbit);
+	set_bit(REL_WHEEL, input->relbit);
+
+	ret = input_register_device(input);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register input device: %d\n", ret);
+		goto err_free_input;
+	}
+
+	platform_set_drvdata(pdev, mouse_dev);
+
+	dev_info(&pdev->dev, "Wasm mouse driver initialized\n");
+	return 0;
+
+err_free_input:
+	input_free_device(input);
+err_free_dev:
+	kfree(mouse_dev);
+	return ret;
+}
+
+static int mouse_wasm_remove(struct platform_device *pdev)
+{
+	struct mouse_wasm_dev *mouse_dev = platform_get_drvdata(pdev);
+
+	if (mouse_dev_global == mouse_dev)
+		mouse_dev_global = NULL;
+
+	input_unregister_device(mouse_dev->input);
+	kfree(mouse_dev);
+
+	return 0;
+}
+
+static struct platform_driver mouse_wasm_driver = {
+	.probe	= mouse_wasm_probe,
+	.remove	= mouse_wasm_remove,
+	.driver	= {
+		.name	= DRIVER_NAME,
+	},
+};
+
+static struct platform_device *mouse_wasm_pdev;
+
+static int __init mouse_wasm_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&mouse_wasm_driver);
+	if (ret)
+		return ret;
+
+	mouse_wasm_pdev = platform_device_register_simple(DRIVER_NAME, -1, NULL, 0);
+	if (IS_ERR(mouse_wasm_pdev)) {
+		platform_driver_unregister(&mouse_wasm_driver);
+		return PTR_ERR(mouse_wasm_pdev);
+	}
+
+	return 0;
+}
+
+module_init(mouse_wasm_init);
+
+MODULE_DESCRIPTION("Wasm mouse input driver");
+MODULE_LICENSE("GPL");
-- 
