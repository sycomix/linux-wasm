From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Linux-Wasm Builder <builder@linux-wasm.local>
Date: Mon, 11 Nov 2025 00:00:00 +0000
Subject: [PATCH] Update wasm_defconfig for framebuffer support

Adds framebuffer and framebuffer console configuration options.
---
 arch/wasm/configs/wasm_defconfig | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/wasm/configs/wasm_defconfig b/arch/wasm/configs/wasm_defconfig
index 10fb9e0ab..c5e2a1f3d 100644
--- a/arch/wasm/configs/wasm_defconfig
+++ b/arch/wasm/configs/wasm_defconfig
@@ -7,6 +7,16 @@ CONFIG_MAGIC_SYSRQ=y
 CONFIG_DEBUG_KERNEL=y
 CONFIG_DEBUG_INFO_DWARF5=y
 CONFIG_HVC_WASM=y
+
+# Framebuffer support
+CONFIG_FB=y
+CONFIG_FB_WASM=y
+CONFIG_FB_CFB_FILLRECT=y
+CONFIG_FB_CFB_COPYAREA=y
+CONFIG_FB_CFB_IMAGEBLIT=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_LOGO=y
+CONFIG_LOGO_LINUX_CLUT224=y
 
 CONFIG_BLK_DEV_INITRD=y
 
-- 
2.34.1
